HOST="0.0.0.0"
ADMIN_NAME="admin"
ADMIN_PASSWORD="admin123"
# Optional. Leave unset to use backend/.venv/bin/python3 when present, otherwise python3.
# PREPROCESS_PYTHON="/absolute/path/to/python3"
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGIN="http://localhost:5173"
