NODE_ENV="production"
DATABASE_URL="postgresql://postgres:YOUR_PG_PASSWORD@localhost:5432/student_test_platform?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4100
HOST="0.0.0.0"
ADMIN_NAME="admin"
ADMIN_PASSWORD="pick-a-real-password"
PREPROCESS_PYTHON="C:\\Users\\YOUR_USERNAME\\AppData\\Local\\Programs\\Python\\Python313\\python.exe"
CORS_ORIGIN="http://localhost:5173,http://192.168.29.196:5173"

# --- Before use ---
# 1. Rename this file to ".env" (remove the ".windows-server.example" part)
# 2. Replace YOUR_PG_PASSWORD with the postgres password you set during install
# 3. Replace the PREPROCESS_PYTHON path with the real output of `where python` on this machine
# 4. Change JWT_SECRET and ADMIN_PASSWORD to real values, not the placeholders above
